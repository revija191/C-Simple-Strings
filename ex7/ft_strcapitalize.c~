char	*ft_strcapitalize(char *str)
{
	int		i;
	char	c;
	char	cp;

	i = 0;
	if (*str == '\0')
		return (str);
	while (*(str + i) != '\0')
	{
		c = *(str + i);
		if (i == 0)
		{
			if (c >= 'a' && c <= 'z')
				*(str + i) = *(str + i) - 32;
		}
		else
		{
			cp = *(str + (i - 1));
			if ! ((cp >= 'a' && cp <= 'z') || (cp >= 'A' && cp <= 'Z')|| (cp >= '0' && cp <='9'))
				if (c >= 'a' && c <= 'z')
					*(str + i) = *(str + i) - 32;
			else
				if (c>= 'A' && c <= 'Z')
					*(str + i) = *(str + i) + 32;
		}
		i++;
	}
	return (str);
}
